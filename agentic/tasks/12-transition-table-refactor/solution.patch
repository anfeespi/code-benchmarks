diff -ruN a/payment/transitions.go b/payment/transitions.go
--- a/payment/transitions.go	1969-12-31 19:00:00
+++ b/payment/transitions.go	2026-10-14 11:20:23
@@ -0,0 +1,18 @@
+package payment
+
+// transitions lists every allowed status change.
+var transitions = map[Status][]Status{
+	StatusCreated:   {StatusPending, StatusDeclined},
+	StatusPending:   {StatusSucceeded, StatusDeclined},
+	StatusSucceeded: {StatusRefunded},
+}
+
+// CanTransition reports whether a payment may move from one status to another.
+func CanTransition(from, to Status) bool {
+	for _, s := range transitions[from] {
+		if s == to {
+			return true
+		}
+	}
+	return false
+}
