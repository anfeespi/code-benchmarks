{
 "title": "Fix the LRU cache with per-entry TTL replay",
 "entry_point": "run_cache",
 "cases": [
  {
   "name": "example_1",
   "code": "result = sol.run_cache(2, [('put', 0, 'a', 1, 5), ('put', 1, 'b', 2, None), ('get', 4, 'a'), ('get', 5, 'a'), ('size', 5)])",
   "expected": {
    "value": [
     1,
     null,
     1
    ]
   }
  },
  {
   "name": "example_2",
   "code": "result = sol.run_cache(2, [('put', 0, 'a', 1, None), ('put', 0, 'b', 2, None), ('put', 1, 'a', 10, None), ('put', 2, 'c', 3, None), ('get', 2, 'a'), ('get', 2, 'b'), ('size', 3)])",
   "expected": {
    "value": [
     10,
     null,
     2
    ]
   }
  },
  {
   "name": "example_3",
   "code": "result = sol.run_cache(2, [('put', 0, 'x', 1, 3), ('put', 1, 'y', 2, None), ('put', 3, 'z', 3, None), ('get', 3, 'y'), ('size', 3)])",
   "expected": {
    "value": [
     2,
     2
    ]
   }
  },
  {
   "name": "expiry_exact_boundary",
