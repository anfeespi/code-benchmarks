{
 "title": "Indentation outline config parser with line-exact errors",
 "entry_point": "parse_outline",
 "cases": [
  {
   "name": "example_1",
   "code": "result = sol.parse_outline('server:\\n  host: example.org\\n  ports:\\n    - 80\\n    - \"443\"\\n    -\\n  limits:\\n  debug: false\\n# top-level comment\\nname:   007  ')",
   "expected": {
    "value": [
     "ok",
     {
      "__dict__": [
       [
        "server",
        {
         "__dict__": [
          [
           "host",
           "example.org"
          ],
          [
           "ports",
           [
            80,
            "443",
            null
           ]
          ],
          [
           "limits",
           null
          ],
          [
           "debug",
           false
          ]
         ]
        }
       ],
       [
        "name",
        "007"
       ]
      ]
     }
    ]
   }
  },
  {
   "name": "example_2",
   "code": "result = sol.parse_outline('a:\\n    b: 1\\n  c: 2')",
   "expected": {
    "value": [
     "error",
     3,
     "inconsistent dedent"
    ]
   }
  },
  {
   "name": "example_3",
   "code": "result = sol.parse_outline('a: 1\\n  b: 2')",
   "expected": {
    "value": [
     "error",
     2,
     "unexpected indent"
    ]
   }
  },
  {
   "name": "example_4",
   "code": "result = sol.parse_outline('a: 1\\nb:\\n  - x\\n  y: 2\\nc \"oops\"')",
   "expected": {
    "value": [
     "error",
     4,
     "mixed block"
    ]
   }
  },
  {
   "name": "example_5",
   "code": "result = sol.parse_outline('k: v\\nk: w')",
   "expected": {
    "value": [
     "error",
     2,
     "duplicate key 'k'"
    ]
   }
  },
  {
   "name": "example_6",
   "code": "result = sol.parse_outline('\\n  # indented comment\\n\\t\\n')",
   "expected": {
