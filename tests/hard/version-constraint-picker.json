   "code": "vs = ['0.0.0', '0.5.1', '1.1.0', '1.2.0', '1.3.7', '2.0.0', '1.20.0']\nresult = [sol.pick_version(vs, c) for c in ['@1.2', '@1.3', '@1.21', '@0.0', '1.*', '1.2.*', '0.*', '2.0.*', '@2.0, !=2.0.0', '1.* , !=1.20.0 , >1.2.0']]",
