{
 "title": "Version picker for a custom constraint language with release candidates",
 "entry_point": "pick_version",
 "cases": [
  {
   "name": "example_1",
   "code": "result = sol.pick_version(['1.2.0', '1.10.0~rc1', '1.9.9', '2.0.0'], '@1.2, <2.0.0')",
   "expected": {
    "value": "1.9.9"
   }
  },
  {
   "name": "example_2_rc_allowed",
   "code": "result = sol.pick_version(['1.2.0', '1.10.0~rc1', '1.9.9', '2.0.0'], '?@1.2, <2.0.0')",
   "expected": {
    "value": "1.10.0~rc1"
   }
  },
  {
   "name": "example_3_rc_below_release",
   "code": "result = sol.pick_version(['0.9.0', '1.0.0~rc3'], '?>=0.9.0, <1.0.0 | 3.*')",
   "expected": {
    "value": "1.0.0~rc3"
   }
  },
  {
   "name": "example_4_empty_clause",
   "code": "try:\n    sol.pick_version([], '1.*, ,2')\n    result = 'no error'\nexcept Exception as e:\n    result = (type(e).__name__, str(e))",
   "expected": {
    "value": [
     "ValueError",
     "alternative 1, clause 2: invalid clause ''"
    ]
   }
  },
  {
   "name": "numeric_not_lexicographic",
   "code": "result = [sol.pick_version(['1.9.0', '1.10.0', '1.2.0'], '*'), sol.pick_version(['9.0.0', '10.0.0'], '<10.0.0'), sol.pick_version(['1.0.9', '1.0.10'], '1.0.*')]",
   "expected": {
    "value": [
     "1.10.0",
     "9.0.0",
     "1.0.10"
    ]
   }
  },
  {
   "name": "rc_ordering",
   "code": "vs = ['2.0.0~rc2', '2.0.0~rc10', '2.0.0~rc9', '1.99.99']\nresult = [sol.pick_version(vs, '?*'), sol.pick_version(vs, '*'), sol.pick_version(vs, '?<2.0.0~rc10'), sol.pick_version(vs + ['2.0.0'], '?<=2.0.0'), sol.pick_version(vs + ['2.0.0'], '?!=2.0.0')]",
   "expected": {
    "value": [
     "2.0.0~rc10",
     "1.99.99",
     "2.0.0~rc9",
     "2.0.0",
     "2.0.0~rc10"
    ]
   }
  },
  {
   "name": "rc_needs_question_mark",
   "code": "result = [sol.pick_version(['1.0.0~rc1'], '=1.0.0~rc1'), sol.pick_version(['1.0.0~rc1'], '? =1.0.0~rc1'), sol.pick_version(['1.0.0~rc1'], '1.0.0~rc1 | ?1.0.0~rc1'), sol.pick_version(['1.0.0~rc1', '0.1.0'], '1.* | 0.*')]",
   "expected": {
    "value": [
     null,
     "1.0.0~rc1",
     "1.0.0~rc1",
     "0.1.0"
    ]
   }
  },
  {
