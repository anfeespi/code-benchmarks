   "name": "prompt_example_1",
   "code": "ml = sol.MergeLedger()\nfor name in [\"a\", \"b\", \"c\", \"d\"]:\n    ml.add(name, 1)\nr = [ml.merge(\"a\", \"b\"), ml.merge(\"c\", \"d\"), ml.merge(\"b\", \"d\"), ml.same(\"d\", \"a\")]\nml.undo()\nr += [ml.same(\"c\", \"d\"), ml.same(\"a\", \"c\"), ml.component_size(\"c\"),\n      ml.component_size(\"a\"), ml.components()]\nresult = r\n",
   "timeout_s": 5,
   "expected": {
    "value": [
     true,
     true,
     true,
     true,
     true,
     false,
     2,
     2,
     2
    ]
   }
  },
  {
   "name": "prompt_example_2",
   "code": "ml = sol.MergeLedger()\nml.add(\"x\", 10); ml.add(\"y\", 20)\nr = [ml.merge(\"x\", \"y\")]\nml.add_value(\"y\", 100)\nr.append(ml.component_value(\"x\"))\nml.undo()\nr += [ml.component_value(\"x\"), ml.component_value(\"y\"), ml.components(), ml.same(\"x\", \"y\")]\nresult = r\n",
   "timeout_s": 5,
   "expected": {
    "value": [
     true,
     130,
     10,
     120,
     2,
     false
    ]
   }
  },
