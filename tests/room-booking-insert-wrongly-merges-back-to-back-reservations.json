{
 "title": "Room booking insert wrongly merges back-to-back reservations",
 "entry_point": "insert_booking",
 "cases": [
  {
   "name": "touching_after_stays_separate",
   "code": "result = sol.insert_booking([(1, 3)], (3, 5))",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      1,
      3
     ],
     [
      3,
      5
     ]
    ]
   }
  },
  {
   "name": "touching_before_stays_separate",
   "code": "result = sol.insert_booking([(3, 5)], (1, 3))",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      1,
      3
     ],
     [
      3,
      5
     ]
    ]
   }
  },
  {
   "name": "touching_on_both_sides",
   "code": "result = sol.insert_booking([(0, 2), (4, 6)], (2, 4))",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      0,
      2
     ],
     [
      2,
      4
     ],
     [
      4,
      6
     ]
    ]
   }
  },
  {
   "name": "merges_overlapping_group",
