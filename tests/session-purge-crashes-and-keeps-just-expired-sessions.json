   "timeout_s": 5,
   "expected": {
    "value": [
     [
      "a",
      "c"
     ],
     {
      "__dict__": [
       [
        "b",
        20
       ]
      ]
     },
     true
    ]
   }
  },
  {
   "name": "expiry_equal_to_now_is_expired",
