{
 "title": "Bounty scheduling with slot capacity",
 "entry_point": "max_bounty",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "brute force: every subset of jobs, kept if an earliest-deadline slot filling places it"
 },
 "cases": [
  {
   "name": "v4:example_cap1",
   "code": "result = sol.max_bounty([(1, 10), (1, 20), (2, 30)], 1)",
   "timeout_s": 5,
   "expected": {
    "value": 50
   }
  },
  {
   "name": "v4:example_cap2",
   "code": "result = sol.max_bounty([(1, 10), (1, 20), (2, 30)], 2)",
   "timeout_s": 5,
   "expected": {
    "value": 60
   }
  },
  {
   "name": "v4:example_two_of_three",
   "code": "result = sol.max_bounty([(2, 5), (2, 7), (2, 9)], 1)",
   "timeout_s": 5,
   "expected": {
    "value": 16
   }
  },
  {
   "name": "v4:empty_jobs",
   "code": "result = (sol.max_bounty([], 1), sol.max_bounty([], 8))",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     0
    ]
   }
  },
  {
   "name": "v4:cap_zero_raises",
   "code": "result = sol.max_bounty([(1, 5), (2, 7)], 0)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:cap_negative_raises",
   "code": "result = sol.max_bounty([(3, 5)], -2)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:duplicates_and_far_deadline",
   "code": "result = (sol.max_bounty([(1, 7), (1, 7), (1, 7)], 2),\n          sol.max_bounty([(10**9, 1000)] * 10, 1),\n          sol.max_bounty([(1, 1), (1, 1000000)], 1))",
   "timeout_s": 5,
   "expected": {
    "value": [
     14,
     10000,
     1000000
    ]
   }
  },
  {
   "name": "v4:scarce_slots_medium",
   "code": "import random\nrnd = random.Random(7)\njobs = [(rnd.randint(1, 20), rnd.randint(1, 1000)) for _ in range(400)]\nresult = (sol.max_bounty(jobs, 1), sol.max_bounty(jobs, 3), sol.max_bounty(jobs, 8))",
   "timeout_s": 5,
   "expected": {
    "value": [
     19618,
     55690,
     125453
    ]
   }
  },
  {
