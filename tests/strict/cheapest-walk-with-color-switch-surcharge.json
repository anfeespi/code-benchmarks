   "timeout_s": 5,
   "expected": {
    "value": 0
   }
  },
  {
   "name": "zero_weight_edges",
   "code": "result = sol.min_cost_route(4, [(0, 1, 0, 'a'), (1, 2, 0, 'a'), (2, 3, 0, 'b')], 0, 3, 4)",
   "timeout_s": 5,
   "expected": {
