{
 "title": "Cheapest walk with color-switch surcharge",
 "entry_point": "min_cost_route",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "Bellman-Ford fixpoint over (node, color of last edge) states"
 },
 "cases": [
  {
   "name": "v4:example_avoid_cheap_red_edge",
   "code": "result = sol.min_cost_route(4, [(0,1,1,'red'), (0,2,2,'blue'), (2,1,1,'blue'), (1,3,1,'blue')], 0, 3, 10)",
   "timeout_s": 5,
   "expected": {
    "value": 4
   }
  },
  {
   "name": "v4:example_forced_switch",
   "code": "result = sol.min_cost_route(3, [(0,1,2,'r'), (1,2,3,'g')], 0, 2, 5)",
   "timeout_s": 5,
   "expected": {
    "value": 10
   }
  },
  {
   "name": "v4:example_unreachable",
   "code": "result = sol.min_cost_route(2, [], 0, 1, 3)",
   "timeout_s": 5,
   "expected": {
    "value": -1
   }
  },
  {
   "name": "v4:source_equals_target",
   "code": "result = (sol.min_cost_route(1, [], 0, 0, 4), sol.min_cost_route(3, [(0,1,7,'a')], 1, 1, 0))",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     0
    ]
   }
  },
  {
   "name": "v4:zero_switch_cost",
   "code": "result = sol.min_cost_route(4, [(0,1,1,'red'), (0,2,2,'blue'), (2,1,1,'blue'), (1,3,1,'blue')], 0, 3, 0)",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:parallel_edges_and_self_loop",
   "code": "result = sol.min_cost_route(3, [(0,1,5,'a'), (0,1,1,'b'), (0,0,1,'a'), (1,2,1,'b')], 0, 2, 10)",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:two_switches_charged",
   "code": "result = sol.min_cost_route(4, [(0,1,1,'a'), (1,2,1,'b'), (2,3,1,'a')], 0, 3, 100)",
   "timeout_s": 5,
   "expected": {
    "value": 203
   }
  },
  {
   "name": "v4:undirected_edges_usable_backwards",
   "code": "result = sol.min_cost_route(3, [(2,1,4,'x'), (1,0,4,'x')], 0, 2, 9)",
   "timeout_s": 5,
   "expected": {
    "value": 8
   }
  },
  {
   "name": "v4:detour_cheaper_than_switching",
   "code": "result = sol.min_cost_route(5, [(0,1,1,'p'), (1,4,1,'q'), (0,2,2,'q'), (2,3,2,'q'), (3,4,2,'q')], 0, 4, 50)",
   "timeout_s": 5,
   "expected": {
    "value": 6
   }
  },
  {
   "name": "v4:large_random_graph",
   "code": "import random\nrnd = random.Random(0)\nn = 400\nedges = []\nfor i in range(n - 1):\n    edges.append((i, i + 1, rnd.randrange(1, 20), 'c%d' % rnd.randrange(3)))\nfor _ in range(1200):\n    edges.append((rnd.randrange(n), rnd.randrange(n), rnd.randrange(1, 50), 'c%d' % rnd.randrange(3)))\nresult = sol.min_cost_route(n, edges, 0, n - 1, 7)",
   "timeout_s": 20,
   "expected": {
    "value": 47
   }
  },
  {
   "name": "self_loop_only_unreachable",
   "code": "result = sol.min_cost_route(2, [(0, 0, 1, 'a')], 0, 1, 5)",
   "timeout_s": 5,
   "expected": {
    "value": -1
   }
  },
  {
   "name": "s_eq_t_with_edges",
