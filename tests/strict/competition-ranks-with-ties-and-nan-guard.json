{
 "title": "Competition ranks with ties and NaN guard",
 "entry_point": "rank_scores",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "sort descending + bisect: rank = 1 + count of strictly greater scores"
 },
 "cases": [
  {
   "name": "v4:basic_distinct",
   "code": "result = sol.rank_scores([50, 90, 70])",
   "timeout_s": 5,
   "expected": {
    "value": [
     3,
     1,
     2
    ]
   }
  },
  {
   "name": "v4:ties_skip_ranks",
   "code": "result = sol.rank_scores([10, 20, 20, 5])",
   "timeout_s": 5,
   "expected": {
    "value": [
     3,
     1,
     1,
     4
    ]
   }
  },
  {
   "name": "v4:empty",
   "code": "result = sol.rank_scores([])",
   "timeout_s": 5,
   "expected": {
    "value": []
   }
  },
  {
   "name": "v4:single",
   "code": "result = sol.rank_scores([5])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1
    ]
   }
  },
  {
   "name": "v4:all_equal_negative",
   "code": "result = sol.rank_scores([-1.0, -1.0, -1.0])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     1,
     1
    ]
   }
  },
  {
   "name": "v4:negative_zero_equals_zero",
   "code": "result = sol.rank_scores([-0.0, 0.0, 1, -1])",
   "timeout_s": 5,
   "expected": {
    "value": [
     2,
     2,
     1,
     4
    ]
   }
  },
  {
   "name": "v4:int_equals_float",
   "code": "result = sol.rank_scores([2, 2.0, 1, 3])",
   "timeout_s": 5,
   "expected": {
    "value": [
     2,
     2,
     4,
     1
    ]
   }
  },
  {
   "name": "v4:infinities",
   "code": "result = sol.rank_scores([float('inf'), 0, float('-inf'), float('inf'), -2.5])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     3,
     5,
     1,
     4
    ]
   }
  },
  {
   "name": "v4:nan_raises",
   "code": "result = sol.rank_scores([1.0, float('nan'), 2.0])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:nan_first_raises",
   "code": "result = sol.rank_scores([float('nan')])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:input_not_mutated",
   "code": "xs = [3, 1, 2, 1]\nr = sol.rank_scores(xs)\nresult = (xs, r)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      3,
      1,
      2,
      1
     ],
     [
      1,
      3,
      2,
      3
     ]
    ]
   }
  },
  {
   "name": "v4:larger_deterministic",
   "code": "scores = [((i * i) % 17) - 8 for i in range(60)]\nresult = sol.rank_scores(scores)",
   "timeout_s": 5,
   "expected": {
    "value": [
     57,
     50,
     36,
     22,
     1,
     29,
     43,
     8,
