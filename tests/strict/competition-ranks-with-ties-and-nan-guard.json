   }
  },
  {
   "name": "two_equal",
   "code": "result = sol.rank_scores([4, 4])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     1
    ]
   }
  },
  {
   "name": "strictly_descending",
   "code": "result = sol.rank_scores([9, 7, 5, 3, 1])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     2,
     3,
     4,
     5
    ]
   }
  },
  {
   "name": "strictly_ascending",
   "code": "result = sol.rank_scores([1, 3, 5, 7, 9])",
   "timeout_s": 5,
   "expected": {
    "value": [
     5,
     4,
     3,
     2,
     1
    ]
   }
  },
  {
   "name": "ties_at_bottom",
   "code": "result = sol.rank_scores([5, 1, 1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     2,
     2,
     2
    ]
   }
  },
  {
   "name": "multiple_tie_groups",
   "code": "result = sol.rank_scores([3, 1, 3, 2, 1, 3, 2])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     6,
     1,
     4,
     6,
     1,
     4
    ]
   }
  },
  {
   "name": "neg_zero_vs_zero_ties",
   "code": "result = sol.rank_scores([0.0, -0.0, 0, -0.0, -1e-300, 1e-300])",
   "timeout_s": 5,
   "expected": {
    "value": [
     2,
     2,
     2,
     2,
     6,
     1
    ]
   }
  },
  {
   "name": "int_float_equal_mixed",
   "code": "result = sol.rank_scores([1, 1.0, 2.0, 2, 3, 0.5])",
   "timeout_s": 5,
   "expected": {
    "value": [
     4,
     4,
     2,
     2,
     1,
     6
    ]
   }
  },
  {
   "name": "huge_ints",
   "code": "result = sol.rank_scores([1000000000000000000000000000000, 1000000000000000000000000000001, -1000000000000000000000000000000, 1000000000000000000000000000000])",
   "timeout_s": 5,
   "expected": {
    "value": [
     2,
     1,
     4,
     2
    ]
   }
  },
  {
   "name": "int_float_exact_compare",
   "code": "result = sol.rank_scores([9007199254740993, 9007199254740992.0, 9007199254740992])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     2,
     2
    ]
   }
  },
  {
   "name": "all_negative_floats",
   "code": "result = sol.rank_scores([-0.5, -1.5, -0.25, -1.5])",
   "timeout_s": 5,
   "expected": {
    "value": [
     2,
     3,
     1,
     3
    ]
   }
  },
  {
   "name": "inf_and_neg_inf_ties",
   "code": "inf = float('inf')\nresult = sol.rank_scores([-inf, inf, 1e308, inf, -inf, -1e308])",
   "timeout_s": 5,
   "expected": {
    "value": [
     5,
     1,
     3,
     1,
     5,
     4
    ]
   }
  },
  {
   "name": "only_infinities",
   "code": "result = sol.rank_scores([float('-inf'), float('inf')])",
   "timeout_s": 5,
   "expected": {
    "value": [
     2,
     1
    ]
   }
  },
  {
   "name": "nan_last_raises",
   "code": "result = sol.rank_scores([1, 2, 3, float('nan')])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "nan_among_infinities_raises",
   "code": "result = sol.rank_scores([float('inf'), float('nan'), float('-inf')])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "nan_mutation_free",
   "code": "xs = [3.0, float('nan')]\ntry:\n    sol.rank_scores(xs)\n    raised = False\nexcept ValueError:\n    raised = True\nresult = (raised, len(xs), xs[0])",
   "timeout_s": 5,
   "expected": {
    "value": [
     true,
     2,
     3.0
    ]
   }
  },
  {
   "name": "float_input_not_mutated",
   "code": "xs = [2.5, -1.0, 2.5, 0.0, -0.0]\nsnap = list(xs)\nr = sol.rank_scores(xs)\nresult = (xs == snap, [repr(x) for x in xs], r)",
   "timeout_s": 5,
   "expected": {
    "value": [
     true,
     [
      "2.5",
      "-1.0",
      "2.5",
      "0.0",
      "-0.0"
