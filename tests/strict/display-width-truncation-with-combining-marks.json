{
 "title": "Display-width truncation with combining marks",
 "entry_point": "truncate_display",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "index scan: positions of unit starts (non-mark, or first char), slice at start index #width"
 },
 "cases": [
  {
   "name": "v4:accent_stays_with_base",
   "code": "result = sol.truncate_display('cafe\\u0301s', 4)",
   "timeout_s": 5,
   "expected": {
    "value": "café"
   }
  },
  {
   "name": "v4:two_marks_one_unit",
   "code": "result = sol.truncate_display('a\\u0300\\u0316b', 1)",
   "timeout_s": 5,
   "expected": {
    "value": "à̖"
   }
  },
  {
   "name": "v4:width_beyond_units",
   "code": "result = sol.truncate_display('hello', 10)",
   "timeout_s": 5,
   "expected": {
    "value": "hello"
   }
  },
  {
   "name": "v4:width_equals_units",
   "code": "result = sol.truncate_display('cafe\\u0301s', 5)",
   "timeout_s": 5,
   "expected": {
    "value": "cafés"
   }
  },
  {
   "name": "v4:width_zero",
   "code": "result = sol.truncate_display('cafe\\u0301s', 0)",
   "timeout_s": 5,
   "expected": {
    "value": ""
   }
  },
  {
   "name": "v4:empty_string",
   "code": "result = (sol.truncate_display('', 5), sol.truncate_display('', 0))",
   "timeout_s": 5,
   "expected": {
    "value": [
     "",
     ""
    ]
   }
  },
  {
   "name": "v4:negative_width_raises",
   "code": "result = sol.truncate_display('abc', -1)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:leading_combining_marks",
   "code": "result = sol.truncate_display('\\u0301\\u0302abc', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "́̂a"
   }
  },
  {
   "name": "v4:astral_counts_one",
   "code": "result = sol.truncate_display('a\\U0001F600b\\U0001F1E6', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "a😀"
   }
  },
  {
   "name": "v4:mc_and_me_categories",
   "code": "result = (sol.truncate_display('\\u0915\\u093e\\u0916', 1), sol.truncate_display('a\\u0488b', 1))",
   "timeout_s": 5,
   "expected": {
    "value": [
     "का",
     "a҈"
    ]
   }
  },
  {
   "name": "v4:larger_deterministic",
   "code": "s = ''.join(c + '\\u0301\\u0308' for c in 'abcdefghijklmnopqrstuvwxyz')\nresult = (sol.truncate_display(s, 10), len(sol.truncate_display(s, 10)), sol.truncate_display(s, 26) == s)",
   "timeout_s": 5,
   "expected": {
    "value": [
     "á̈b́̈ć̈d́̈é̈f́̈ǵ̈h́̈í̈j́̈",
     30,
     true
    ]
   }
  },
  {
   "name": "single_base",
   "code": "result = sol.truncate_display('x', 1)",
   "timeout_s": 5,
   "expected": {
    "value": "x"
   }
  },
  {
   "name": "single_base_width_zero",
   "code": "result = sol.truncate_display('x', 0)",
   "timeout_s": 5,
   "expected": {
    "value": ""
   }
  },
  {
   "name": "only_marks_is_one_unit",
   "code": "result = sol.truncate_display('́̂̃', 1)",
   "timeout_s": 5,
   "expected": {
    "value": "́̂̃"
   }
  },
  {
   "name": "only_marks_width_zero",
   "code": "result = sol.truncate_display('́̂̃', 0)",
   "timeout_s": 5,
   "expected": {
    "value": ""
   }
  },
  {
   "name": "leading_marks_then_base",
   "code": "result = sol.truncate_display('́̂ab', 1)",
   "timeout_s": 5,
   "expected": {
    "value": "́̂"
   }
  },
  {
   "name": "leading_marks_width_three",
   "code": "result = sol.truncate_display('́̂ab', 3)",
   "timeout_s": 5,
   "expected": {
    "value": "́̂ab"
   }
  },
  {
   "name": "enclosing_mark_me",
   "code": "result = sol.truncate_display('1⃣ 2⃣', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "1⃣ "
   }
  },
  {
   "name": "devanagari_mc_marks",
   "code": "result = sol.truncate_display('काखिग', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "काखि"
   }
  },
  {
   "name": "many_marks_on_one_base",
   "code": "result = sol.truncate_display('é́́́́́́́́́́́́́́́́́́́́́́́́́́́́́f', 1)",
   "timeout_s": 5,
   "expected": {
    "value": "é́́́́́́́́́́́́́́́́́́́́́́́́́́́́́"
   }
  },
  {
   "name": "hebrew_points",
   "code": "result = sol.truncate_display('שָׁלוֹם', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "שָׁל"
   }
  },
  {
   "name": "cjk_counts_one_each",
   "code": "result = sol.truncate_display('中文字', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "中文"
   }
  },
  {
   "name": "emoji_with_variation_selector",
   "code": "result = sol.truncate_display('❤️❤️', 1)",
   "timeout_s": 5,
   "expected": {
    "value": "❤️"
   }
  },
  {
   "name": "zwj_is_its_own_unit",
   "code": "result = sol.truncate_display('👨\\u200d👩', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "👨‍"
   }
  },
  {
   "name": "regional_indicators_separate",
   "code": "result = sol.truncate_display('🇨🇴🇺', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "🇨🇴"
   }
  },
  {
   "name": "precomposed_vs_decomposed",
   "code": "result = sol.truncate_display('ééé', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "éé"
   }
  },
  {
   "name": "whitespace_and_newline",
   "code": "result = sol.truncate_display(' \\n\\t', 2)",
   "timeout_s": 5,
   "expected": {
    "value": " \n"
   }
  },
  {
   "name": "width_huge",
   "code": "result = sol.truncate_display('abć', 1000000000)",
   "timeout_s": 5,
   "expected": {
    "value": "abć"
   }
  },
  {
   "name": "width_exact_units_with_trailing_mark",
   "code": "result = sol.truncate_display('ab́', 2)",
   "timeout_s": 5,
   "expected": {
    "value": "ab́"
   }
  },
  {
   "name": "negative_width_on_empty_raises",
   "code": "result = sol.truncate_display('', -1)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "negative_width_large_raises",
   "code": "result = sol.truncate_display('abc', -10**9)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "width_equal_units_returns_same",
   "code": "s = 'x\\u0301y\\u0302'\nr = sol.truncate_display(s, 2)\nresult = (r == s, r)",
   "timeout_s": 5,
   "expected": {
    "value": [
     true,
     "x́ŷ"
    ]
   }
  },
