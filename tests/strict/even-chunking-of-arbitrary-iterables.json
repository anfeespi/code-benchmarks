{
 "title": "Even chunking of arbitrary iterables",
 "entry_point": "chunk_evenly",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "drain once, then ceil((remaining)/(chunks left)) sizes (longer chunks first)"
 },
 "cases": [
  {
   "name": "v4:list_uneven",
   "code": "result = sol.chunk_evenly([1, 2, 3, 4, 5], 2)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      1,
      2,
      3
     ],
     [
      4,
      5
     ]
    ]
   }
  },
  {
   "name": "v4:one_shot_generator",
   "code": "result = sol.chunk_evenly((x for x in 'abcd'), 3)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      "a",
      "b"
     ],
     [
      "c"
     ],
     [
      "d"
     ]
    ]
   }
  },
  {
   "name": "v4:empty_input",
   "code": "result = sol.chunk_evenly([], 3)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [],
     [],
     []
    ]
   }
  },
  {
   "name": "v4:fewer_than_n",
   "code": "result = sol.chunk_evenly([7], 4)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      7
     ],
     [],
     [],
     []
    ]
   }
  },
  {
   "name": "v4:n_equals_one",
   "code": "result = sol.chunk_evenly([1, 2, 3], 1)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      1,
      2,
      3
     ]
    ]
   }
  },
  {
   "name": "v4:exact_division",
   "code": "result = sol.chunk_evenly([1, 2, 3, 4, 5, 6], 3)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      1,
      2
     ],
     [
      3,
      4
     ],
     [
      5,
      6
     ]
    ]
   }
  },
  {
   "name": "v4:tuple_gives_lists",
   "code": "result = sol.chunk_evenly(('a', 'b', 'c'), 2)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      "a",
      "b"
     ],
     [
      "c"
     ]
    ]
   }
  },
  {
   "name": "v4:empty_generator",
   "code": "result = sol.chunk_evenly((x for x in []), 2)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [],
     []
    ]
   }
  },
  {
   "name": "v4:n_zero_raises",
   "code": "result = sol.chunk_evenly([1, 2], 0)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:n_negative_raises",
   "code": "result = sol.chunk_evenly([1, 2], -2)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:mixed_types_and_duplicates",
   "code": "result = sol.chunk_evenly([None, 'a', None, 3.5, 'a'], 2)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      null,
      "a",
      null
     ],
     [
      3.5,
      "a"
     ]
    ]
   }
  },
  {
