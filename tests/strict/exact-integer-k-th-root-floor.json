{
 "title": "Exact integer k-th root floor",
 "entry_point": "kth_root_floor",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "Decimal(prec=120) exp(ln(n)/k) estimate, then integer fix-up until r**k <= n < (r+1)**k"
 },
 "cases": [
  {
   "name": "v4:cube_exact",
   "code": "result = sol.kth_root_floor(27, 3)",
   "timeout_s": 5,
   "expected": {
    "value": 3
   }
  },
  {
   "name": "v4:cube_below",
   "code": "result = sol.kth_root_floor(26, 3)",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:big_exact_cube",
