{
 "title": "Exactly-k non-adjacent picks on a circle",
 "entry_point": "best_circular_selection",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "enumerate all k-subsets, check circular non-adjacency"
 },
 "cases": [
  {
   "name": "v4:example_wrap_adjacency",
   "code": "result = sol.best_circular_selection([10, -5, -5, 10], 2)",
   "timeout_s": 5,
   "expected": {
    "value": 5
   }
  },
  {
   "name": "v4:example_five_elements",
   "code": "result = sol.best_circular_selection([3, 4, 5, 6, 7], 2)",
   "timeout_s": 5,
   "expected": {
    "value": 12
   }
  },
  {
   "name": "v4:example_all_negative",
   "code": "result = sol.best_circular_selection([-1, -2, -3], 1)",
   "timeout_s": 5,
   "expected": {
    "value": -1
   }
  },
  {
   "name": "v4:example_two_elements_k2_raises",
   "code": "result = sol.best_circular_selection([1, 2], 2)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:k_zero_returns_zero",
   "code": "result = (sol.best_circular_selection([5, 5, 5], 0), sol.best_circular_selection([-9], 0))",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     0
    ]
   }
  },
  {
   "name": "v4:single_element_k1",
   "code": "result = sol.best_circular_selection([7], 1)",
   "timeout_s": 5,
   "expected": {
    "value": 7
   }
  },
  {
   "name": "v4:single_element_k2_raises",
   "code": "result = sol.best_circular_selection([7], 2)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:two_elements_k1",
   "code": "result = sol.best_circular_selection([3, 9], 1)",
   "timeout_s": 5,
   "expected": {
    "value": 9
   }
  },
  {
   "name": "v4:too_many_picks_raises",
   "code": "result = sol.best_circular_selection([1, 2, 3, 4], 3)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:large_seeded",
   "code": "import random\nrnd = random.Random(0)\nvals = [rnd.randrange(-1000000, 1000000) for _ in range(300)]\nresult = sol.best_circular_selection(vals, 75)",
   "timeout_s": 20,
   "expected": {
    "value": 54484013
   }
  },
  {
   "name": "k_zero_all_negative",
   "code": "result = sol.best_circular_selection([-5, -6, -7], 0)",
   "timeout_s": 5,
   "expected": {
    "value": 0
   }
  },
  {
   "name": "two_elements_k1_negative",
   "code": "result = sol.best_circular_selection([-3, -9], 1)",
   "timeout_s": 5,
   "expected": {
    "value": -3
   }
  },
  {
   "name": "three_k2_raises",
   "code": "result = sol.best_circular_selection([1, 2, 3], 2)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "four_k2_must_alternate",
   "code": "result = sol.best_circular_selection([1, 100, 1, 100], 2)",
   "timeout_s": 5,
   "expected": {
    "value": 200
   }
  },
  {
   "name": "five_k2_negatives_forced",
   "code": "result = sol.best_circular_selection([-1, -1, -1, -1, -1], 2)",
   "timeout_s": 5,
   "expected": {
    "value": -2
   }
  },
  {
   "name": "five_k3_raises",
   "code": "result = sol.best_circular_selection([9, 9, 9, 9, 9], 3)",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "six_k3_alternating",
   "code": "result = sol.best_circular_selection([5, 1, 5, 1, 5, 1], 3)",
   "timeout_s": 5,
   "expected": {
    "value": 15
   }
  },
  {
   "name": "k_equals_n_raises",
