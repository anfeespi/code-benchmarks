{
 "title": "Grid shortest path with one same-label teleport",
 "entry_point": "min_steps",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "Dijkstra over (cell, teleport_used) with explicit teleport edges to every other same-label cell"
 },
 "cases": [
  {
   "name": "v4:example_teleport_only",
   "code": "result = sol.min_steps([[0, -1], [-1, 0]], 7)",
   "timeout_s": 5,
   "expected": {
    "value": 7
   }
  },
  {
   "name": "v4:example_walk_only",
   "code": "result = sol.min_steps([[1, 2], [3, 4]], 100)",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:example_mixed_walk_and_teleport",
   "code": "result = sol.min_steps([[5, -1, 5], [0, -1, 0]], 3)",
   "timeout_s": 5,
   "expected": {
    "value": 4
   }
  },
  {
   "name": "v4:blocked_endpoints",
   "code": "result = (sol.min_steps([[-1, 0], [0, 0]], 1), sol.min_steps([[0, 0], [0, -1]], 1))",
   "timeout_s": 5,
   "expected": {
    "value": [
     -1,
     -1
    ]
   }
  },
  {
   "name": "v4:single_cell",
   "code": "result = (sol.min_steps([[3]], 4), sol.min_steps([[-1]], 4))",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     -1
    ]
   }
  },
  {
   "name": "v4:unreachable_distinct_labels",
   "code": "result = sol.min_steps([[0, -1], [-1, 1]], 2)",
   "timeout_s": 5,
   "expected": {
    "value": -1
   }
  },
  {
   "name": "v4:free_teleport",
   "code": "result = sol.min_steps([[5, -1], [-1, 5]], 0)",
   "timeout_s": 5,
   "expected": {
    "value": 0
   }
  },
  {
   "name": "v4:walk_beats_expensive_teleport",
   "code": "result = sol.min_steps([[7, 7, 7], [7, 7, 7], [7, 7, 7]], 10)",
   "timeout_s": 5,
   "expected": {
    "value": 4
   }
  },
  {
   "name": "v4:teleport_beats_long_walk",
   "code": "result = sol.min_steps([[7, 7, 7], [7, 7, 7], [7, 7, 7]], 2)",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:single_row_corridor",
   "code": "result = sol.min_steps([[1, 2, 3, 2, 1]], 1)",
   "timeout_s": 5,
   "expected": {
    "value": 1
   }
  },
  {
   "name": "v4:large_uniform_label_grid",
   "code": "R = C = 300\ngrid = [[1] * C for _ in range(R)]\nresult = sol.min_steps(grid, 1000)",
   "timeout_s": 5,
   "expected": {
    "value": 598
   }
  },
  {
   "name": "start_cell_unique_label_no_teleport",
   "code": "result = sol.min_steps([[1, -1], [-1, 2]], 0)",
   "timeout_s": 5,
   "expected": {
    "value": -1
   }
  },
  {
   "name": "teleport_to_self_label_not_target",
   "code": "result = sol.min_steps([[4, -1, 4], [-1, -1, 9]], 0)",
   "timeout_s": 5,
   "expected": {
    "value": 1
   }
  },
  {
   "name": "single_row_teleport",
   "code": "result = sol.min_steps([[3, -1, -1, 3]], 5)",
   "timeout_s": 5,
   "expected": {
    "value": 5
   }
  },
  {
   "name": "single_column",
   "code": "result = sol.min_steps([[1], [2], [-1], [2], [1]], 2)",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "teleport_mid_path",
   "code": "result = sol.min_steps([[0, 1, -1, 5], [-1, 2, -1, 2], [-1, -1, -1, 6]], 4)",
   "timeout_s": 5,
   "expected": {
    "value": 7
   }
  },
  {
   "name": "teleport_used_only_once",
   "code": "result = sol.min_steps([[1, -1, 1, -1, 2, -1, 2]], 0)",
   "timeout_s": 5,
   "expected": {
    "value": -1
   }
  },
  {
   "name": "label_max_value",
   "code": "result = sol.min_steps([[1000000, -1], [-1, 1000000]], 1000000)",
   "timeout_s": 5,
   "expected": {
    "value": 1000000
   }
  },
  {
   "name": "cost_equal_to_walk",
   "code": "result = sol.min_steps([[5, 5, 5, 5]], 3)",
   "timeout_s": 5,
   "expected": {
    "value": 3
   }
  },
  {
   "name": "walk_one_cheaper_than_teleport",
   "code": "result = sol.min_steps([[5, 5, 5, 5]], 4)",
   "timeout_s": 5,
   "expected": {
    "value": 3
   }
  },
  {
   "name": "teleport_from_label_reached_by_walk",
   "code": "result = sol.min_steps([[0, 1, -1, -1], [-1, 8, -1, 8], [-1, -1, -1, 3]], 1)",
   "timeout_s": 5,
   "expected": {
    "value": 4
   }
  },
  {
   "name": "target_blocked_only",
   "code": "result = sol.min_steps([[0, 0], [0, -1]], 0)",
   "timeout_s": 5,
   "expected": {
    "value": -1
   }
  },
  {
   "name": "random_batch_00",
   "code": "result = [sol.min_steps(*a) for a in [([[0], [1], [1], [1], [-1]], 0), ([[3, 0], [3, 3], [0, 0], [0, 0]], 3), ([[1, 0, 1, 1], [3, 2, 3, 1]], 20), ([[-1, -1, -1, -1, -1], [1000000, 7, 7, -1, 7], [-1, 1000000, 1000000, 1000000, 7], [7, -1, 1000000, 7, -1]], 1), ([[0, 0, 0], [0, 0, 0]], 2), ([[1000000, 1000000, -1, 7], [-1, 1000000, 7, 1000000], [7, 7, 1000000, -1], [-1, -1, -1, 1000000], [7, -1, -1, 7]], 1), ([[7], [1000000], [7], [7], [-1]], 1), ([[0, -1], [-1, -1]], 20), ([[0], [0]], 20), ([[1, 0, 0], [0, 1, 1]], 5)]]",
