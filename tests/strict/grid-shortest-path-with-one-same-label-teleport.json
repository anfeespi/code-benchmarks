   "timeout_s": 5,
   "expected": {
    "value": [
     5,
     2,
     3,
     -1,
     3,
     -1,
     6,
     2,
     -1,
     0
    ]
   }
  },
  {
   "name": "random_batch_02",
   "code": "result = [sol.min_steps(*a) for a in [([[1, 0, 0], [0, 0, 0], [1, 1, -1]], 1), ([[7, -1, -1, -1], [-1, -1, -1, -1], [1000000, -1, -1, 1000000]], 3), ([[1, 3, 2, 1, 0]], 3), ([[-1]], 1), ([[2, 1, 3, 3, 1], [0, 0, 3, 0, 2], [1, 1, 1, 2, 3], [2, 0, 2, 2, 2]], 20), ([[0, 0], [0, 0]], 20), ([[0], [1], [1], [0]], 1), ([[3, 3], [0, 2], [0, 1], [3, 1]], 0), ([[0, 0]], 20), ([[1000000, -1], [-1, 1000000]], 2)]]",
   "timeout_s": 5,
   "expected": {
    "value": [
