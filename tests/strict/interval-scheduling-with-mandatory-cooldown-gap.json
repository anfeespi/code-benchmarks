{
 "title": "Interval scheduling with mandatory cooldown gap",
 "entry_point": "max_sessions",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "enumerate all subsets, check gap constraint after sorting by start"
 },
 "cases": [
  {
   "name": "v4:example_no_gap",
   "code": "result = sol.max_sessions([(1, 10), (2, 3), (4, 5)], 0)",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:example_gap_one",
   "code": "result = sol.max_sessions([(0, 2), (2, 4), (4, 6)], 1)",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:example_empty",
