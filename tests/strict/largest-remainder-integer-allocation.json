{
 "title": "Largest-remainder integer allocation",
 "entry_point": "allocate_shares",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 800,
  "agree": 800,
  "reference": "exact Fraction quotas, floor + remainder ordering by (-remainder, index)"
 },
 "cases": [
  {
   "name": "v4:equal_thirds",
   "code": "result = sol.allocate_shares(100, [1, 1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": [
     34,
     33,
     33
    ]
   }
  },
  {
   "name": "v4:quota_example",
   "code": "result = sol.allocate_shares(7, [3, 1])",
   "timeout_s": 5,
   "expected": {
    "value": [
     5,
     2
    ]
   }
  },
  {
   "name": "v4:zero_weight_parties",
   "code": "result = sol.allocate_shares(5, [0, 2, 0])",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     5,
     0
    ]
   }
  },
  {
   "name": "v4:total_zero",
   "code": "result = sol.allocate_shares(0, [1, 2, 3])",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     0,
     0
    ]
   }
  },
  {
   "name": "v4:single_party",
   "code": "result = sol.allocate_shares(13, [4])",
   "timeout_s": 5,
   "expected": {
    "value": [
     13
    ]
   }
  },
  {
   "name": "v4:tie_break_lower_index",
   "code": "result = (sol.allocate_shares(1, [1, 1]), sol.allocate_shares(2, [1, 1, 1]), sol.allocate_shares(1, [1, 1, 1, 1]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      1,
      0
     ],
     [
      1,
      1,
      0
     ],
     [
      1,
      0,
      0,
      0
     ]
    ]
   }
  },
  {
   "name": "v4:float_weights",
   "code": "result = sol.allocate_shares(100, [0.5, 0.25, 0.25])",
   "timeout_s": 5,
   "expected": {
    "value": [
     50,
     25,
     25
    ]
   }
  },
  {
   "name": "v4:shares_are_ints",
   "code": "result = [type(x).__name__ for x in sol.allocate_shares(7, [3, 1])]",
   "timeout_s": 5,
   "expected": {
    "value": [
     "int",
     "int"
    ]
   }
  },
  {
   "name": "v4:negative_total_raises",
   "code": "result = sol.allocate_shares(-1, [1, 1])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
