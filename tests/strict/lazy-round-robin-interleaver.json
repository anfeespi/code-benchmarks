{
 "title": "Lazy round-robin interleaver",
 "entry_point": "round_robin",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "itertools.zip_longest with a sentinel, sentinel dropped (finite inputs)"
 },
 "cases": [
  {
   "name": "v4:mixed_example",
   "code": "result = list(sol.round_robin([[1, 2, 3], 'ab', [10]]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     "a",
     10,
     2,
     "b",
     3
    ]
   }
  },
  {
   "name": "v4:empties_mixed_in",
   "code": "result = list(sol.round_robin([[], [1, 2], []]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     2
    ]
   }
  },
  {
   "name": "v4:empty_input_list",
   "code": "result = list(sol.round_robin([]))",
   "timeout_s": 5,
   "expected": {
    "value": []
   }
  },
  {
   "name": "v4:all_empty",
   "code": "result = list(sol.round_robin([[], [], '']))",
   "timeout_s": 5,
   "expected": {
    "value": []
   }
  },
  {
   "name": "v4:infinite_islice",
   "code": "import itertools\nresult = list(itertools.islice(sol.round_robin([itertools.count(0), itertools.count(100)]), 4))",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     100,
     1,
     101
    ]
   }
  },
  {
   "name": "v4:iterator_protocol",
   "code": "it = sol.round_robin([[1, 2]])\nresult = (iter(it) is it, hasattr(it, '__next__'), next(it), next(it))",
   "timeout_s": 5,
   "expected": {
    "value": [
     true,
     true,
     1,
     2
    ]
   }
  },
  {
   "name": "v4:lazy_not_drained_up_front",
   "code": "class Rec:\n    def __init__(self, n):\n        self.n = n\n        self.i = 0\n    def __iter__(self):\n        return self\n    def __next__(self):\n        if self.i >= self.n:\n            raise StopIteration\n        self.i += 1\n        return self.i\na = Rec(100)\nb = Rec(100)\nit = sol.round_robin([a, b])\nfirst = [next(it), next(it), next(it)]\nresult = (first, a.i, b.i)\n",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      1,
      1,
      2
     ],
     2,
     1
    ]
   }
  },
  {
   "name": "v4:no_over_advance",
   "code": "class Fuse:\n    def __init__(self, limit):\n        self.limit = limit\n        self.calls = 0\n    def __iter__(self):\n        return self\n    def __next__(self):\n        if self.calls >= self.limit:\n            raise RuntimeError('over-advanced')\n        self.calls += 1\n        return self.calls * 10\nimport itertools\nf = Fuse(3)\nresult = list(itertools.islice(sol.round_robin([f]), 3))\n",
   "timeout_s": 5,
   "expected": {
    "value": [
     10,
     20,
     30
    ]
   }
  },
  {
   "name": "v4:drop_out_keeps_order",
   "code": "result = list(sol.round_robin([[1], [2, 3, 4], [5, 6]]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     2,
     5,
     3,
     6,
     4
    ]
   }
  },
  {
   "name": "v4:duplicates_preserved",
