{
 "title": "Longest echoed slice",
 "entry_point": "longest_echo",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "brute force: largest L such that two distinct start positions carry the same length-L substring"
 },
 "cases": [
  {
   "name": "v4:example_banana",
   "code": "result = sol.longest_echo('banana')",
   "timeout_s": 5,
   "expected": {
    "value": 3
   }
  },
  {
   "name": "v4:example_abcabc",
   "code": "result = sol.longest_echo('abcabc')",
   "timeout_s": 5,
   "expected": {
    "value": 3
   }
  },
  {
   "name": "v4:example_aaaa",
