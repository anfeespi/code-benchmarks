   "code": "result = [sol.weighted_median(*a) for a in [([16, -10, -14, -7, 5, -17, 17], [1.5, 1.5, 0.25, 0.25, 2, 0, 0.5]), ([-17, 8, 15], [0.25, 0.5, 2]), ([-5, 3, 2, 1, 5, 4, 17, 17, 20, -6, -14, -15, 5, 14], [0.25, 2, 1.5, 1, 0.25, 1.5, 0, 1.5, 0, 1.5, 3, 1.5, 0.25, 3]), ([-1, 20, 9, -8, -3, -8, -14, 0, 12, 7, 4], [0.5, 0.5, 1.5, 1.5, 0.5, 0.5, 1.5, 0.5, 3, 3, 0.5]), ([-7], [0.25]), ([7, -13], [2, 0]), ([-15, 19, 20, -2, -9, 6, -2, -17, 4, 11, 19], [1, 0.25, 0.25, 0, 3, 2, 0.25, 3, 1, 1.5, 0.5]), ([-4, -16, 13, 12, -3, 8, 11, 16, -4], [2, 1, 0.25, 0, 1, 1.5, 0.25, 0.5, 0]), ([20, 9, -15, -13, 8, 9, 6], [2, 3, 1, 1.5, 3, 0.25, 2]), ([-8], [1.5])]]",
