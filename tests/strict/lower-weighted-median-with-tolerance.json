{
 "title": "Lower weighted median with tolerance",
 "entry_point": "weighted_median",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "group by distinct value, cumulative per distinct value with float sum, threshold W/2 - 1e-9"
 },
 "cases": [
  {
   "name": "v4:odd_uniform",
   "code": "result = sol.weighted_median([3, 1, 2], [1, 1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:even_uniform_exact_half",
   "code": "result = sol.weighted_median([1, 2, 3, 4], [1, 1, 1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:zero_weight_ignored",
   "code": "result = sol.weighted_median([10, 20], [0.0, 5.0])",
   "timeout_s": 5,
   "expected": {
    "value": 20
   }
  },
  {
   "name": "v4:single_pair",
   "code": "result = sol.weighted_median([7.5], [3.0])",
   "timeout_s": 5,
   "expected": {
    "value": 7.5
   }
  },
  {
   "name": "v4:all_identical_values",
   "code": "result = sol.weighted_median([5, 5, 5], [1, 2, 3])",
   "timeout_s": 5,
   "expected": {
    "value": 5
   }
  },
  {
   "name": "v4:negative_values",
   "code": "result = sol.weighted_median([-5, -1, -3], [1, 1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": -3
   }
  },
  {
   "name": "v4:trailing_zero_weight",
   "code": "result = sol.weighted_median([1, 2, 3], [1.0, 1.0, 0.0])",
   "timeout_s": 5,
   "expected": {
    "value": 1
   }
  },
  {
   "name": "v4:tolerance_just_under_half",
   "code": "result = sol.weighted_median([1, 2], [0.9999999999, 1.0000000001])",
   "timeout_s": 5,
   "expected": {
    "value": 1
   }
  },
  {
   "name": "v4:length_mismatch_raises",
   "code": "result = sol.weighted_median([1, 2], [1])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:empty_raises",
   "code": "result = sol.weighted_median([], [])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:all_zero_weights_raises",
   "code": "result = sol.weighted_median([1, 2], [0.0, 0.0])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:negative_weight_raises",
   "code": "result = sol.weighted_median([1, 2], [1.0, -1.0])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:larger_deterministic",
   "code": "values = [((i * 37) % 101) - 50 for i in range(101)]\nweights = [1.0] * 101\nresult = (sol.weighted_median(values, weights), sol.weighted_median(values, [float(i % 3) for i in range(101)]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     2
    ]
   }
  },
  {
   "name": "two_equal_weights_lower",
   "code": "result = sol.weighted_median([5, 9], [1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": 5
   }
  },
  {
   "name": "heavy_last",
   "code": "result = sol.weighted_median([1, 2, 3], [1, 1, 5])",
   "timeout_s": 5,
   "expected": {
    "value": 3
   }
  },
  {
   "name": "heavy_first",
   "code": "result = sol.weighted_median([1, 2, 3], [5, 1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": 1
   }
  },
  {
   "name": "unsorted_with_heavy_middle",
   "code": "result = sol.weighted_median([30, 10, 20], [1, 1, 3])",
   "timeout_s": 5,
   "expected": {
    "value": 20
   }
  },
  {
   "name": "zero_weight_smallest_value",
   "code": "result = sol.weighted_median([-100, 1, 2], [0, 1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": 1
   }
  },
  {
   "name": "zero_weight_leading_and_trailing",
   "code": "result = sol.weighted_median([0, 5, 6, 99], [0.0, 2.0, 2.0, 0.0])",
   "timeout_s": 5,
   "expected": {
    "value": 5
   }
  },
  {
   "name": "duplicate_values_split_weight",
   "code": "result = sol.weighted_median([2, 1, 2, 3], [1, 2, 1, 4])",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "duplicates_cross_half",
   "code": "result = sol.weighted_median([4, 4, 1, 9], [1, 1, 1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": 4
   }
  },
  {
   "name": "single_with_zero_others",
   "code": "result = sol.weighted_median([3, 8, 1], [0, 7.5, 0])",
   "timeout_s": 5,
   "expected": {
    "value": 8
   }
  },
  {
   "name": "negative_floats",
   "code": "result = sol.weighted_median([-1.5, -2.5, -0.5], [1, 1, 1])",
   "timeout_s": 5,
   "expected": {
    "value": -1.5
   }
  },
  {
   "name": "all_identical_values_float",
   "code": "result = sol.weighted_median([2.5, 2.5], [0.1, 0.2])",
   "timeout_s": 5,
   "expected": {
    "value": 2.5
   }
  },
  {
   "name": "decimal_weights_tolerance",
   "code": "result = sol.weighted_median([1, 2, 3], [0.1, 0.2, 0.3])",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "within_tolerance_reaches",
   "code": "result = sol.weighted_median([1, 2], [1.0, 1.000000000002])",
   "timeout_s": 5,
   "expected": {
    "value": 1
   }
  },
  {
   "name": "beyond_tolerance_does_not_reach",
   "code": "result = sol.weighted_median([1, 2], [1.0, 1.000000004])",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "tiny_weights",
   "code": "result = sol.weighted_median([1, 2, 3], [1e-12, 1e-12, 1e-12])",
   "timeout_s": 5,
   "expected": {
    "value": 1
   }
  },
  {
   "name": "large_weights",
   "code": "result = sol.weighted_median([1, 2, 3], [1000000000000000.0, 1000000000000000.0, 2000000000000004.0])",
   "timeout_s": 5,
   "expected": {
    "value": 3
   }
  },
  {
   "name": "single_negative_value",
   "code": "result = sol.weighted_median([-42], [0.5])",
   "timeout_s": 5,
   "expected": {
    "value": -42
   }
  },
  {
   "name": "length_mismatch_longer_weights_raises",
   "code": "result = sol.weighted_median([1], [1, 1])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "length_mismatch_empty_values_raises",
   "code": "result = sol.weighted_median([], [1.0])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "negative_weight_with_positive_total_raises",
   "code": "result = sol.weighted_median([1, 2, 3], [5.0, -0.5, 1.0])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "all_zero_int_weights_raises",
   "code": "result = sol.weighted_median([1, 2, 3], [0, 0, 0])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "result_is_input_value",
   "code": "vals = [0.1, 0.7, 0.3]\nr = sol.weighted_median(vals, [1, 1, 1])\nresult = (r in vals, r)",
   "timeout_s": 5,
   "expected": {
    "value": [
     true,
     0.3
    ]
   }
  },
  {
   "name": "inputs_not_reordered_matter",
   "code": "a = sol.weighted_median([3, 1, 2], [1, 1, 1])\nb = sol.weighted_median([1, 2, 3], [1, 1, 1])\nc = sol.weighted_median([2, 3, 1], [1, 1, 1])\nresult = (a, b, c)",
   "timeout_s": 5,
   "expected": {
    "value": [
     2,
     2,
     2
    ]
   }
  },
