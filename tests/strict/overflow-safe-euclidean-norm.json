{
 "title": "Overflow-safe Euclidean norm",
 "entry_point": "vector_norm",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "exact Fraction sum of squares + 60-digit Decimal sqrt, compared at rel 1e-12"
 },
 "cases": [
  {
   "name": "v4:basic",
   "code": "result = sol.vector_norm([3.0, 4.0])",
   "timeout_s": 5,
   "expected": {
    "value": 5.0
   }
  },
  {
   "name": "v4:huge_no_overflow",
   "code": "result = sol.vector_norm([3e200, -4e200])",
   "timeout_s": 5,
   "expected": {
    "value": 4.9999999999999995e+200
   }
  },
  {
   "name": "v4:tiny_no_underflow",
   "code": "result = sol.vector_norm([3e-200, 4e-200]) / 1e-200",
   "timeout_s": 5,
   "expected": {
    "value": 5.0
   }
  },
  {
   "name": "v4:empty_is_zero",
   "code": "result = sol.vector_norm([])",
   "timeout_s": 5,
   "expected": {
    "value": 0.0
   }
  },
  {
   "name": "v4:all_zero",
   "code": "result = sol.vector_norm([0.0, 0.0, 0.0])",
   "timeout_s": 5,
   "expected": {
    "value": 0.0
   }
  },
  {
   "name": "v4:zero_returns_float",
   "code": "result = [type(sol.vector_norm([])).__name__, type(sol.vector_norm([0.0, 0.0])).__name__]",
   "timeout_s": 5,
   "expected": {
    "value": [
     "float",
     "float"
    ]
   }
  },
  {
   "name": "v4:negatives",
   "code": "result = (sol.vector_norm([-3.0, -4.0]), sol.vector_norm([-7.5]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     5.0,
     7.5
    ]
   }
  },
  {
   "name": "v4:mixed_scales",
   "code": "result = sol.vector_norm([1e-200, 1.0, 1e200]) / 1e200",
   "timeout_s": 5,
   "expected": {
    "value": 1.0
   }
  },
  {
   "name": "v4:huge_with_zeros",
   "code": "result = sol.vector_norm([0.0, 5e300, 0.0, -1.0]) / 1e300",
   "timeout_s": 5,
   "expected": {
    "value": 5.0
   }
  },
  {
   "name": "v4:nan_raises",
   "code": "result = sol.vector_norm([1.0, float('nan')])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:inf_raises",
   "code": "result = sol.vector_norm([float('inf'), 1.0])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:neg_inf_raises",
   "code": "result = sol.vector_norm([1.0, float('-inf')])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:larger_deterministic",
   "code": "vals = [float(i) if i % 2 else -float(i) for i in range(1, 101)]\nresult = sol.vector_norm(vals)",
   "timeout_s": 5,
   "expected": {
    "value": 581.6786054171153
   }
  },
  {
   "name": "single_huge",
   "code": "v = [1e308]\nresult = sol.vector_norm(v) / 1e308",
   "timeout_s": 5,
   "expected": {
    "value": 1.0
   }
  },
  {
   "name": "single_negative_huge",
   "code": "v = [-1.5e308]\nresult = sol.vector_norm(v) / 1e308",
   "timeout_s": 5,
   "expected": {
    "value": 1.5
   }
  },
  {
   "name": "two_huge_near_max",
   "code": "v = [1e308, 1e307]\nresult = sol.vector_norm(v) / 1e308",
   "timeout_s": 5,
   "expected": {
    "value": 1.004987562112089
   }
  },
  {
   "name": "pythagorean_tiny",
   "code": "v = [-3e-300, 4e-300]\nresult = sol.vector_norm(v) / 1e-300",
   "timeout_s": 5,
   "expected": {
    "value": 5.0
   }
  },
  {
   "name": "min_normal",
   "code": "v = [2.2250738585072014e-308, 2.2250738585072014e-308]\nresult = sol.vector_norm(v) / 1e-308",
   "timeout_s": 5,
   "expected": {
    "value": 3.146729627982718
   }
  },
  {
   "name": "many_huge_terms",
   "code": "v = [1e300] * 100\nresult = sol.vector_norm(v) / 1e301",
   "timeout_s": 5,
   "expected": {
    "value": 1.0
   }
  },
  {
   "name": "many_tiny_terms",
   "code": "v = [1e-300] * 10000\nresult = sol.vector_norm(v) / 1e-298",
   "timeout_s": 5,
   "expected": {
    "value": 1.0000000000000002
   }
  },
  {
   "name": "huge_and_tiny_mixed",
   "code": "v = [1e-300, 3e200, 1e-300, -4e200]\nresult = sol.vector_norm(v) / 1e200",
   "timeout_s": 5,
   "expected": {
    "value": 5.0
   }
  },
  {
   "name": "tiny_dominates_zero",
   "code": "v = [0.0, -0.0, 7e-250]\nresult = sol.vector_norm(v) / 1e-250",
   "timeout_s": 5,
   "expected": {
    "value": 6.999999999999999
   }
  },
  {
   "name": "single_value",
   "code": "result = sol.vector_norm([2.5])",
   "timeout_s": 5,
   "expected": {
    "value": 2.5
   }
  },
  {
   "name": "single_negative",
   "code": "result = sol.vector_norm([-0.125])",
   "timeout_s": 5,
   "expected": {
    "value": 0.125
   }
  },
  {
   "name": "negative_zero_only",
   "code": "r = sol.vector_norm([-0.0])\nresult = (type(r).__name__, r)",
   "timeout_s": 5,
   "expected": {
    "value": [
     "float",
     0.0
    ]
   }
  },
  {
   "name": "single_zero_is_float",
   "code": "r = sol.vector_norm([0.0])\nresult = (type(r).__name__, r)",
   "timeout_s": 5,
   "expected": {
    "value": [
     "float",
     0.0
    ]
   }
  },
  {
   "name": "nonzero_returns_float",
   "code": "r = sol.vector_norm([3e200, 4e200])\nresult = (type(r).__name__, r / 1e200)",
   "timeout_s": 5,
   "expected": {
    "value": [
     "float",
     5.0
    ]
   }
  },
  {
   "name": "cancellation_free_ones",
   "code": "result = sol.vector_norm([1.0] * 10000)",
   "timeout_s": 5,
   "expected": {
    "value": 100.0
   }
  },
  {
   "name": "accuracy_1e12_moderate",
   "code": "result = sol.vector_norm([1.0, 1e-8])",
   "timeout_s": 5,
   "expected": {
    "value": 1.0
   }
  },
  {
   "name": "nan_only_raises",
   "code": "result = sol.vector_norm([float('nan')])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "inf_only_raises",
   "code": "result = sol.vector_norm([float('inf')])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "neg_inf_last_raises",
   "code": "result = sol.vector_norm([0.0, 1e300, -float('inf')])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "nan_after_huge_raises",
   "code": "result = sol.vector_norm([1e308, 1e308, float('nan')])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "inf_with_zeros_raises",
