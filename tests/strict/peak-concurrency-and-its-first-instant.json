{
 "title": "Peak concurrency and its first instant",
 "entry_point": "peak_load",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "brute force: load counted at every integer time in [min s, max e)"
 },
 "cases": [
  {
   "name": "v4:example_overlap",
   "code": "result = sol.peak_load([(1, 4), (2, 6), (4, 7)])",
   "timeout_s": 5,
   "expected": {
    "value": [
     2,
     2
    ]
   }
  },
  {
   "name": "v4:example_single",
   "code": "result = sol.peak_load([(0, 10)])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     0
    ]
   }
  },
  {
   "name": "v4:example_touching",
   "code": "result = sol.peak_load([(3, 5), (5, 8)])",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     3
    ]
   }
  },
  {
   "name": "v4:tie_earliest_wins",
   "code": "result = (sol.peak_load([(0, 2), (5, 7)]),\n          sol.peak_load([(1, 3), (1, 3), (4, 6), (4, 6)]),\n          sol.peak_load([(10, 11), (0, 1)]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      1,
      0
     ],
     [
      2,
      1
     ],
     [
      1,
      0
     ]
    ]
   }
  },
  {
   "name": "v4:duplicates_and_bounds",
