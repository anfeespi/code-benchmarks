{
 "title": "Session purge crashes and keeps just-expired sessions",
 "entry_point": "purge_expired",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "collect ids with expiry <= now in iteration order, compare remaining dict"
 },
 "cases": [
  {
   "name": "v4:purges_in_place_without_crashing",
   "code": "s = {'a': 5, 'b': 20, 'c': 5}\nsame = s\nr = sol.purge_expired(s, 10)\nresult = (r, s, s is same)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      "a",
      "c"
     ],
     {
      "__dict__": [
       [
        "b",
        20
       ]
      ]
     },
     true
    ]
   }
  },
  {
   "name": "v4:expiry_equal_to_now_is_expired",
   "code": "s = {'a': 5}\nr = sol.purge_expired(s, 5)\nresult = (r, s)",
   "timeout_s": 5,
   "expected": {
    "value": [
     [
      "a"
     ],
     {
      "__dict__": []
     }
    ]
   }
  },
