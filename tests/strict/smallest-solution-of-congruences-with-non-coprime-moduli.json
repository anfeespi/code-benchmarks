{
 "title": "Smallest solution of congruences with non-coprime moduli",
 "entry_point": "solve_congruences",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "scan x = 0 .. lcm-1 checking every congruence"
 },
 "cases": [
  {
   "name": "v4:example_coprime",
   "code": "result = sol.solve_congruences([(2, 3), (3, 5), (2, 7)])",
   "timeout_s": 5,
   "expected": {
    "value": 23
   }
  },
  {
   "name": "v4:example_shared_factor_consistent",
   "code": "result = sol.solve_congruences([(2, 4), (2, 6)])",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:example_inconsistent",
   "code": "result = sol.solve_congruences([(1, 2), (2, 4)])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:empty_returns_zero",
   "code": "result = sol.solve_congruences([])",
   "timeout_s": 5,
   "expected": {
    "value": 0
   }
  },
  {
   "name": "v4:modulus_one",
   "code": "result = (sol.solve_congruences([(5, 1)]), sol.solve_congruences([(5, 1), (3, 7)]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     3
    ]
   }
  },
  {
   "name": "v4:negative_residues",
   "code": "result = sol.solve_congruences([(-1, 5), (2, 3)])",
   "timeout_s": 5,
   "expected": {
    "value": 14
   }
  },
  {
   "name": "v4:residue_not_reduced",
   "code": "result = (sol.solve_congruences([(9, 4)]), sol.solve_congruences([(13, 5), (22, 7)]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     8
    ]
   }
  },
  {
   "name": "v4:non_coprime_chain",
   "code": "result = sol.solve_congruences([(2, 4), (2, 6), (8, 9)])",
   "timeout_s": 5,
   "expected": {
    "value": 26
   }
  },
  {
   "name": "v4:inconsistent_parity",
   "code": "result = sol.solve_congruences([(1, 6), (4, 10)])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "v4:twenty_large_moduli",
   "code": "import random\nrnd = random.Random(0)\nx0 = 987654321987654321\nmods = [rnd.randrange(2, 1000000000) for _ in range(20)]\npairs = [(x0 % m, m) for m in mods]\nresult = sol.solve_congruences(pairs)",
   "timeout_s": 20,
   "expected": {
    "value": 987654321987654321
   }
  },
  {
   "name": "single_pair",
   "code": "result = sol.solve_congruences([(4, 7)])",
   "timeout_s": 5,
   "expected": {
    "value": 4
   }
  },
  {
   "name": "single_negative_residue",
   "code": "result = sol.solve_congruences([(-1, 1000000000)])",
   "timeout_s": 5,
   "expected": {
    "value": 999999999
   }
  },
  {
   "name": "residue_equal_modulus",
   "code": "result = sol.solve_congruences([(6, 6), (0, 4)])",
   "timeout_s": 5,
   "expected": {
    "value": 0
   }
  },
  {
   "name": "duplicate_pairs",
   "code": "result = sol.solve_congruences([(3, 8), (3, 8), (3, 8)])",
   "timeout_s": 5,
   "expected": {
    "value": 3
   }
  },
  {
   "name": "same_modulus_conflict_raises",
   "code": "result = sol.solve_congruences([(3, 8), (4, 8)])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "same_modulus_equivalent_residues",
   "code": "result = sol.solve_congruences([(3, 8), (11, 8), (-5, 8)])",
   "timeout_s": 5,
   "expected": {
    "value": 3
   }
  },
  {
   "name": "divisor_modulus_consistent",
   "code": "result = sol.solve_congruences([(7, 12), (1, 3), (3, 4)])",
   "timeout_s": 5,
   "expected": {
    "value": 7
   }
  },
  {
   "name": "divisor_modulus_inconsistent",
   "code": "result = sol.solve_congruences([(7, 12), (2, 3)])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "large_prime_moduli",
   "code": "result = sol.solve_congruences([(123456, 999999937), (654321, 999999929), (1, 2)])",
   "timeout_s": 5,
   "expected": {
    "value": 1875066106870951281
   }
  },
  {
   "name": "large_shared_factor",
   "code": "result = sol.solve_congruences([(999999999, 1000000000), (499999999, 500000000)])",
   "timeout_s": 5,
   "expected": {
    "value": 999999999
   }
  },
  {
   "name": "large_shared_factor_inconsistent",
   "code": "result = sol.solve_congruences([(999999999, 1000000000), (0, 500000000)])",
   "timeout_s": 5,
   "raises": "ValueError"
  },
  {
   "name": "huge_residue_values",
   "code": "result = sol.solve_congruences([(1000000000000000007, 97), (-1000000000000000000, 89)])",
   "timeout_s": 5,
   "expected": {
    "value": 8341
   }
  },
  {
   "name": "all_moduli_one",
   "code": "result = sol.solve_congruences([(5, 1), (-7, 1), (0, 1)])",
   "timeout_s": 5,
   "expected": {
    "value": 0
   }
  },
  {
   "name": "answer_is_lcm_minus_one",
   "code": "result = sol.solve_congruences([(-1, 4), (-1, 6), (-1, 9), (-1, 10)])",
   "timeout_s": 5,
   "expected": {
    "value": 179
   }
  },
