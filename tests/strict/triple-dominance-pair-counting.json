{
 "title": "Triple-dominance pair counting",
 "entry_point": "count_dominant_pairs",
 "suite": "v4-strict",
 "crosscheck": {
  "n": 500,
  "agree": 500,
  "reference": "brute force: all i < j pairs checked with seq[i] > 3 * seq[j]"
 },
 "cases": [
  {
   "name": "v4:example_basic",
   "code": "result = sol.count_dominant_pairs([9, 2, 1, 7])",
   "timeout_s": 5,
   "expected": {
    "value": 2
   }
  },
  {
   "name": "v4:example_negative",
   "code": "result = sol.count_dominant_pairs([-2, -1])",
   "timeout_s": 5,
   "expected": {
    "value": 1
   }
  },
  {
   "name": "v4:example_zeros",
   "code": "result = sol.count_dominant_pairs([0, 0])",
   "timeout_s": 5,
   "expected": {
    "value": 0
   }
  },
  {
   "name": "v4:tiny_inputs",
   "code": "result = (sol.count_dominant_pairs([]), sol.count_dominant_pairs([5]), sol.count_dominant_pairs([1, 0]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     0,
     0,
     1
    ]
   }
  },
  {
   "name": "v4:sign_handling",
   "code": "result = (sol.count_dominant_pairs([-1, -1]),\n          sol.count_dominant_pairs([-3, -1, -2]),\n          sol.count_dominant_pairs([10**9, -10**9]),\n          sol.count_dominant_pairs([-10**9, 10**9]),\n          sol.count_dominant_pairs([1, -1, 1, -1]))",
   "timeout_s": 5,
   "expected": {
    "value": [
     1,
     2,
     1,
     0,
     4
    ]
   }
  },
  {
   "name": "v4:random_small_batch",
   "code": "import random\nrnd = random.Random(6)\nout = []\nfor hi in (3, 10, 1000, 10**9):\n    xs = [rnd.randint(-hi, hi) for _ in range(150)]\n    out.append(sol.count_dominant_pairs(xs))\nresult = out",
   "timeout_s": 5,
   "expected": {
    "value": [
     4832,
     5495,
     5346,
     5700
    ]
   }
  },
  {
   "name": "v4:large_random",
   "code": "import random\nrnd = random.Random(0)\nseq = [rnd.randint(-10**9, 10**9) for _ in range(150000)]\nresult = sol.count_dominant_pairs(seq)",
   "timeout_s": 6,
   "expected": {
    "value": 5666695839
   }
  },
  {
   "name": "v4:large_decreasing",
